{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "falq-shop",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "falq-shop"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			// Local `next dev` uses Miniflare D1. Production Worker still binds the real falq-db.
			// `remote: true` was leaving env.falq_db undefined locally (TypeError on prepare).
			"binding": "falq_db",
			"database_name": "falq-db",
			"database_id": "c25e2c08-e9cb-4fd1-9413-adc9c915750d",
			"migrations_dir": "migrations"
		}
	]
}